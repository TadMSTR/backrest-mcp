# Backrest base URL (default: http://localhost:9898)
BACKREST_URL=http://localhost:9898

# Basic auth (optional — omit if auth is disabled)
BACKREST_USERNAME=
BACKREST_PASSWORD=

# TLS: if using a private CA, set:
# REQUESTS_CA_BUNDLE=/path/to/ca.crt (httpx respects this)
# Do NOT disable TLS verification.

# Safety controls
# BACKREST_READONLY=true         — read-only mode; no write tools registered (default: true)
# BACKREST_ALLOW_DESTRUCTIVE=false — enables forget_snapshot and restore_snapshot (default: false)
#                                    requires BACKREST_READONLY=false
# BACKREST_RESTORE_ALLOWED_PREFIX=/tmp/backrest-restore/  — restore target must be under this path
# BACKREST_AUDIT_LOG=            — path for write-op audit log (JSONL); empty = disabled

# Transport (default: stdio — one subprocess per turn, no network surface)
# BACKREST_MCP_TRANSPORT=stdio    — stdio (default) or http (long-lived PM2 service)
# BACKREST_MCP_HTTP_HOST=127.0.0.1 — bind host for http mode; non-loopback refused unless override
# BACKREST_MCP_HTTP_PORT=8626     — bind port for http mode
# BACKREST_MCP_AUTH_TOKEN=        — bearer token, REQUIRED in http mode (>= 16 chars)
#                                    generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# BACKREST_MCP_ALLOW_NONLOOPBACK=  — set to 1 to permit a non-loopback bind (not recommended)

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Optional telemetry (install the matching extra: pip install -e ".[influxdb|otel|nats]")
INFLUXDB_URL=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# NATS_URL=
